# Discovr — nginx site config (template) for the SHARED E-Cell server
#
# Install ADDITIVELY — this box already serves ~20 other sites.
# Never remove sites-enabled/default or another team's file.
#
# Render with:
#   sed -e 's/__STUDENT_HOST__/discovr.iitr.ac.in/g' \
#       -e 's/__CLUB_HOST__/discovr-club.iitr.ac.in/g' \
#       -e 's/__ADMIN_HOST__/discovr-admin.iitr.ac.in/g' \
#       -e 's/__API_HOST__/discovr-api.iitr.ac.in/g' \
#       deploy/nginx/discovr.conf.template | sudo tee /etc/nginx/sites-available/discovr.conf
#
# TLS uses the institute wildcard certificate for *.iitr.ac.in issued by
# GlobalSign AlphaSSL, supplied by ICC:
#   /etc/ssl/discovr/fullchain.pem  leaf + GlobalSign GCC R6 AlphaSSL CA 2025
#   /etc/ssl/discovr/privkey.pem    mode 0600, root
#
# !! RENEWAL IS MANUAL. This certificate expires 2027-02-08. Unlike the
# certbot-managed certs elsewhere on this box, nothing renews it automatically.
# Set a calendar reminder for January 2027 to request a new one from ICC.

upstream discovr_api {
    server 127.0.0.1:3001;
    keepalive 16;
}

# ---------------------------------------------------------- HTTP -> HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name __STUDENT_HOST__ __CLUB_HOST__ __ADMIN_HOST__ __API_HOST__;

    # Sessions are issued Secure + SameSite=None, so plain HTTP cannot hold a
    # login. Everything is redirected rather than served.
    return 301 https://$host$request_uri;
}

# ---------------------------------------------------------------- student
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __STUDENT_HOST__;

    ssl_certificate     /etc/ssl/discovr/fullchain.pem;
    ssl_certificate_key /etc/ssl/discovr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    root /var/www/discovr/student;
    index index.html;

    access_log /var/log/nginx/discovr-student.access.log;
    error_log  /var/log/nginx/discovr-student.error.log;

    # Note: a location with its own add_header drops server-level ones, so the
    # asset and service-worker blocks below deliberately do not inherit HSTS.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://res.cloudinary.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://__API_HOST__ https://api.cloudinary.com https://*.googleapis.com https://*.firebaseio.com https://*.firebaseapp.com; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Vite emits content-hashed filenames into /assets, so they cache hard.
    # add_header alone — `expires` would emit a second Cache-Control header.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Mirrors the header student/vercel.json set: the push service worker must
    # revalidate on every load or devices keep running an old FCM handler.
    location = /firebase-messaging-sw.js {
        add_header Cache-Control "public, max-age=0, must-revalidate";
        try_files $uri =404;
    }

    location = /site.webmanifest {
        add_header Cache-Control "public, max-age=0, must-revalidate";
        try_files $uri =404;
    }

    # Replaces the Vercel rewrite: unknown paths are handled by the SPA router.
    location / {
        try_files $uri $uri/ /index.html;
    }
}

