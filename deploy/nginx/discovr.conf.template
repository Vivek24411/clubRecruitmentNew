# ---------------------------------------------------------------- express api
server {
    listen 80;
    listen [::]:80;
    server_name __API_HOST__;

    access_log /var/log/nginx/discovr-api.access.log;
    error_log  /var/log/nginx/discovr-api.error.log;

    # upload.js allows 5 files x 50MB on the media route; leave headroom for the
    # multipart envelope. Too low here surfaces as a 413 before Express sees it.
    client_max_body_size 60m;

    # CORS is answered by app.js against ALLOWED_ORIGINS. Do not add
    # Access-Control-* headers here or browsers will see duplicates and block.
    location / {
        proxy_pass http://discovr_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        # Stream uploads straight to multer instead of spooling them to disk.
        proxy_request_buffering off;

        proxy_connect_timeout 10s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;
    }

    location = /ping {
        access_log off;
        proxy_pass http://discovr_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
    }
}
