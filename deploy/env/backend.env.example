# /srv/discovr/backend/.env   (chmod 600)
#
# Copy the VALUES from the Render dashboard (Service -> Environment), not from
# your local backend/.env — that one holds dev values.

NODE_ENV=production
PORT=3001

# Behind nginx on the same box: exactly one proxy hop. Needed so req.ip is the
# real client IP for rate limiting instead of 127.0.0.1.
TRUST_PROXY_HOPS=1

# The API drains no jobs; deploy/pm2 runs worker.js as its own process.
RUN_JOBS_IN_API=false

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/DBNAME?retryWrites=true&w=majority

# Must be >= 32 characters or the app refuses to boot in production.
# Generate: openssl rand -base64 48
JWT_SECRET=

ADMIN_EMAIL=ecell@iitr.ac.in
# ADMIN_PASSWORD is rejected in production — a bcrypt hash is required.
# Generate on the server (see runbook Phase 5).
ADMIN_PASSWORD_HASH=

# Exact origins, comma separated, no trailing slashes, no localhost in prod.
ALLOWED_ORIGINS=https://discovr.iitr.ac.in,https://club.discovr.iitr.ac.in,https://admin.discovr.iitr.ac.in

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=Discovr <noreply@expediva.in>

PUSH_NOTIFICATIONS_ENABLED=true
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Used to build deep links inside push payloads — the student app origin.
STUDENT_APP_ORIGIN=https://discovr.iitr.ac.in
